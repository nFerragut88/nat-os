// app_tap -- the first NatScript program with a user interface.
//
// Every NatScript program before this one was a serial-console program, on a
// board whose entire point is a panel and a touchscreen. `fill` and `text` were
// reachable and `touch` was not, so a program could draw something and then had
// no way to learn whether anybody had touched it.
//
// WHAT AN APPLICATION'S CANVAS ACTUALLY IS, because the first version of this
// program got it wrong: a horizontal strip, 180 x 14 pixels, at y = 224 + 16*id
// (kernel/app.h). Not the panel. The kernel owns everything else, including the
// close button, so that the one control needed to escape a misbehaving program
// is the one control that program cannot touch.
//
// Fourteen pixels tall. So this is a ROW of cells rather than a grid, sized
// from what the viewport says it is rather than from what the panel is.

let BG   = 0x0000
let EDGE = 0x39E7
let INK  = 0xFFFF
let HIT  = 0x07FF

let CELLS = 6

buf label[16]

let w = screen.width
let h = screen.height
let cw = w / CELLS

let taps = 0
let lastcell = 0 - 1

// A cell is drawn inside a one-pixel margin, so the dividing lines are the
// background showing through rather than lines anybody had to draw.
func cell(c, colour) {
    screen.fill(c * cw + 1, 1, cw - 2, h - 2, colour)
}

// [step 366] This was nine lines of byte stores:
//
//     label[0] = 116          // t
//     label[1] = 97           // a
//     ...
//     label[i] = 48 + n % 10
//
// It was written that way because NatScript had no strings, and it was the
// argument for adding them. `format` writes into a buffer this program
// declared, and the compiler passes that buffer's size as a hard limit -- so
// the text is truncated if it does not fit, and never runs past the end.
func render(n) {
    format(label, "taps ", n)
}

screen.fill(0, 0, w, h, EDGE)
let i = 0
while i < CELLS {
    cell(i, BG)
    i = i + 1
}
render(0)
screen.text(label, 2, 4, INK, BG, 1)

print("  [tap] canvas ")
print(w)
print("x")
print(h)
println(" -- touch inside the strip, not the desktop")

// The panel is POLLED, not delivered: `touch` is a syscall a program asks, and
// a key is the only thing the kernel pushes. So the tick handler is the poll --
// ten times a second, which is faster than a finger and cheap enough to leave
// the rest of the quantum to everything else.
//
// A touch outside this strip never arrives: the kernel translates into viewport
// coordinates and withholds anything outside, counted as `touch g/w` in the
// telemetry. 4,277 withheld and 0 given is what tapping the desktop looks like.
every 100ms {
    if screen.touched() {
        let c = screen.x / cw
        if c < CELLS && c != lastcell {
            if lastcell >= 0 {
                cell(lastcell, BG)
            }
            cell(c, HIT)
            lastcell = c
            taps = taps + 1
            render(taps)
            screen.text(label, 2, 4, INK, HIT, 1)
            print("  [tap] cell ")
            print(c)
            print(" at ")
            print(screen.x)
            print(",")
            print(screen.y)
            print(" taps ")
            println(taps)
        }
    }
}
