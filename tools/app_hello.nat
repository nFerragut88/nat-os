// app_hello -- the first nat-os program that was not written in assembly.
//
// Every other program in tools/ is hand-written vasm. This one is NatScript,
// compiled by tools/natc.py into assembly, assembled by tools/vasm.py into
// bytecode, and run by the VM with no kernel change of any kind.
//
// It is deliberately a program that would be TEDIOUS to write by hand, because
// a language that only handles what assembly handles comfortably has not
// demonstrated anything. Recursion with real frames, nested calls, and
// short-circuit conditions are the parts the frame convention exists for.

permissions {
    // Nothing. It prints and computes, and the manifest says so out loud
    // rather than by omission -- an empty block is a claim, a missing block
    // is a question.
}

func fib(n) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func gcd(a, b) {
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

// Three nested frames deep, each with locals the callee must not disturb.
func triangle(n) {
    let sum = 0
    let i = 1
    while i <= n {
        sum = sum + i
        i = i + 1
    }
    return sum
}

func classify(n) {
    if n % 15 == 0 {
        return 15
    } else if n % 3 == 0 {
        return 3
    } else if n % 5 == 0 {
        return 5
    }
    return 0
}

println("  [hello] compiled from NatScript, not assembled")

let i = 0
while i < 10 {
    print("  [hello] fib(", i, ") = ", fib(i))
    println("")
    i = i + 1
}

print("  [hello] gcd(1071, 462) = ", gcd(1071, 462))
println("")
print("  [hello] triangle(100) = ", triangle(100))
println("")

// Short-circuit: the right side must not be evaluated when the left decides
// the answer. If it were, this would divide by zero and fault the program.
let zero = 0
if zero != 0 && 100 / zero > 0 {
    println("  [hello] FAIL short-circuit && evaluated the right side")
} else {
    println("  [hello] short-circuit && ok")
}

let n = 1
let hits = 0
while n <= 30 {
    if classify(n) == 15 {
        hits = hits + 1
    }
    n = n + 1
}
print("  [hello] multiples of fifteen under thirty: ", hits)
println("")

println("  [hello] done")
