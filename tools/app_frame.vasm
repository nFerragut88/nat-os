; app_frame — proves the stack-frame convention of docs/vm-abi.md section 6.
;
; The VM has no frames: sixteen global registers, and CALL saves only a return
; address, into kernel memory where no bytecode can reach it. A compiler
; therefore has nowhere to put a function's locals, which is the one thing
; genuinely blocking a NatScript compiler (VM-03).
;
; Step 355 made r15 a stack pointer initialised to the top of the arena. This
; program is the evidence that a frame built on it works: it calls a function
; that allocates locals, writes them, calls a SECOND function that allocates
; its own, and checks on the way back out that nothing was trampled.
;
; It needs no VM change. Every store here is bounds-checked against the arena
; exactly like any other, so a runaway stack faults the program and nothing
; else -- which is why a convention was enough.

start:
        ; r15 arrives as the arena size, rounded down to a multiple of four.
        ; Nothing else in the machine knows that; it is a convention.
        mov     r1, r15             ; remember where the stack began
        ldi     r0, @msg_start
        sys     puts

        ldi     r2, 111             ; the argument
        call    outer

        ; r0 carries the result back. 111 + 1 + 2 = 114 if both frames held.
        ldi     r3, 114
        seq     r4, r0, r3
        brz     r4, fail

        ; and the stack pointer must be exactly where it started
        seq     r4, r15, r1
        brz     r4, fail

        ldi     r0, @msg_pass
        sys     puts
        ldi     r0, 0
        sys     exit

fail:
        ldi     r0, @msg_fail
        sys     puts
        ldi     r0, 1
        sys     exit

; ---- outer: two locals, then calls inner -----------------------------------
outer:
        addi    r15, -8             ; prologue: an 8-byte frame
        stw     r2, r15, 0          ; local 0 = the argument
        mov     r5, r2
        addi    r5, 1
        stw     r5, r15, 4          ; local 1 = argument + 1

        call    inner               ; inner allocates its own frame

        ldw     r6, r15, 4          ; local 1 must have survived the call
        mov     r0, r6
        addi    r0, 2
        addi    r15, 8              ; epilogue
        ret

; ---- inner: writes a local of its own, to trample outer's if it can --------
inner:
        addi    r15, -8
        ldi     r7, 999
        stw     r7, r15, 0
        stw     r7, r15, 4
        addi    r15, 8
        ret

        .align  4
msg_start:
        .string  "frame: begin"
msg_pass:
        .string  "frame: PASS locals survived a nested call"
msg_fail:
        .string  "frame: FAIL"
