; Application DEV — the first program to reach a peripheral.
;
; Until now an application could draw, read the touchscreen, print, and exchange
; messages, and that was the entire list. Everything else on this board was
; reachable only from the kernel. This program enumerates the device table,
; names every entry, reads the light sensor and sounds the speaker -- none of
; which required a new syscall, because there is now a device model.
;
; It is also the test of that model. If a program written against the table can
; do this without the kernel being edited, the table works; if it cannot, the
; shape is wrong and better found here than after six more drivers.

start:
        ldi     r13, @publish       ; where the reading is published, set once

        ldi     r0, 0               ; DEV_OP_COUNT
        sys     device
        mov     r10, r0             ; device count, kept for the loop

        ldi     r0, @msg_found
        sys     puts
        mov     r0, r10
        sys     putd
        ldi     r0, @msg_devices
        sys     puts

        ldi     r11, 0              ; id

names:
        sltu    r1, r11, r10
        brz     r1, setup           ; NOT `sensing` -- see the note at setup:

        ldi     r0, 1               ; DEV_OP_NAME
        mov     r1, r11
        ldi     r2, @namebuf
        ldi     r3, 16
        sys     device

        ldi     r0, @msg_dev
        sys     puts
        mov     r0, r11
        sys     putd
        ldi     r0, @msg_colon
        sys     puts
        ldi     r0, @namebuf        ; the kernel wrote into our own arena
        sys     puts
        ldi     r0, @msg_nl
        sys     puts

        ldi     r1, 1
        add     r11, r11, r1
        jmp     names

; ---- read the light sensor, forever, and beep when it goes dark -------------
;
; Device 0 is `light`, device 1 is `beep`. Both are DEV_F_SLOW, so each call
; ends this program's slice -- which is the point: a syscall costing
; milliseconds must not be charged to the instruction quantum.

; ---- claim a persistent slot ------------------------------------------------
;
; Written ONCE, not per reading. Slots are banked by caller, so this lands in
; this application's bank and cannot touch the one the shell writes -- reading
; `dev 2 0` at the prompt afterwards proves it, because it still shows whatever
; the shell put there.
;
; Once, because a slot write marks the record dirty and the kernel saves it
; periodically. A program storing a value that changes every loop would erase a
; flash sector a minute forever, which is how a part rated for a hundred
; thousand cycles gets spent by a program that thought it was being helpful.

; The enumeration loop above exits HERE, not to `sensing`.
;
; It used to branch straight to `sensing`, which jumped clean over this block
; and over `ldi r14, 16` below -- so the slot was never claimed, the counter was
; still 0 from vm_init, and the read loop exited on its first test. The symptom
; was a program that printed the device table, announced sixteen readings, and
; reported a light level of zero without ever having read anything.
;
; Nothing diagnosed it, because nothing was wrong: every syscall it made
; succeeded, and the two it skipped were skipped silently. A jump that lands
; past setup code is invisible to a machine that cannot know what the code was
; for.

setup:
        ldi     r0, 3               ; DEV_OP_WRITE
        ldi     r1, 2               ; device 2, store
        ldi     r2, 0               ; slot 0, in OUR bank
        ldi     r3, 777
        sys     device

; ---- bulk transfer, out of the arena and back into it ----------------------
;
; The shell can drive a transfer too, but it calls device_xfer_* directly and so
; never touches vmarg_span or vmarg_store. Only a PROGRAM exercises the arena
; handling -- the part that copies out of confined memory, across the kernel's
; bounce buffer, and back in again.
;
; Device 5 is `echo`, a loopback that exists so this can be proved on a bare
; board: the only other transfer-capable device is the I2C bus, and with nothing
; plugged into the header the whole path would ship having exercised nothing but
; its refusal case.

        ldi     r0, 5               ; DEV_OP_XFER_OUT
        ldi     r1, 5               ; device 5, echo
        ldi     r2, 0               ; channel 0
        ldi     r3, @xfersrc        ; arena offset of the bytes to send
        ldi     r4, 4
        sys     device
        brz     r0, xferbad

        ldi     r0, 6               ; DEV_OP_XFER_IN
        ldi     r1, 5
        ldi     r2, 0
        ldi     r3, @xferdst        ; a DIFFERENT offset, so a no-op would show
        ldi     r4, 4
        sys     device
        brz     r0, xferbad

        ldi     r6, @xfersrc
        ldw     r5, r6, 0
        ldi     r7, @xferdst
        ldw     r8, r7, 0
        sne     r9, r5, r8          ; 1 if they DIFFER
        brnz    r9, xferbad

        ldi     r0, @msg_xferok
        sys     puts
        jmp     xferdone

xferbad:
        ldi     r0, @msg_xferbad
        sys     puts

xferdone:

; ---- read the light sensor a bounded number of times, then STOP ------------
;
; This used to loop forever and beep whenever the room went dark, which made it
; a resident program that seizes the speaker and cannot be reasoned around. A
; demo should demonstrate and then get out of the way; the on-demand version
; lives in the shell as `light`.
;
; Sixteen readings, published so `ps` can show the last one, then exit.

        ldi     r14, 16             ; readings remaining

sensing:
        brz     r14, done

        ldi     r0, 2               ; DEV_OP_READ
        ldi     r1, 0               ; device 0, light
        ldi     r2, 0               ; channel 0
        sys     device
        brz     r0, sensing         ; refused: try again rather than die

        mov     r12, r1             ; the reading
        stw     r12, r13, 0         ; publish it where the shell can see it

        ; Sixteen lines is not a flood. The version that printed every reading
        ; of an ENDLESS loop was, which is a different problem: the fault was
        ; the unbounded loop, not the printing.
        ldi     r0, @msg_light
        sys     puts
        mov     r0, r12
        sys     putd
        ldi     r0, @msg_nl
        sys     puts

        ldi     r1, 1
        sub     r14, r14, r1
        jmp     sensing

done:
        ldi     r0, @msg_done
        sys     puts
        mov     r0, r12
        sys     putd
        ldi     r0, @msg_nl
        sys     puts

        ldi     r0, 0
        sys     exit

        .align  4
publish:
        .word   0
namebuf:
        .space  16

        .align  4
xfersrc:
        .byte   0xDE, 0xAD, 0xBE, 0xEF
        .align  4
xferdst:
        .word   0

msg_found:      .string "  [dev] device table: "
msg_devices:    .string " entries\n"
msg_dev:        .string "  [dev] "
msg_colon:      .string " = "
msg_xferok:     .string "  [dev] bulk transfer round trip OK (arena -> echo -> arena)\n"
msg_xferbad:    .string "  [dev] bulk transfer FAILED\n"
msg_light:      .string "  [dev] light = "
msg_done:       .string "  [dev] 16 readings taken, exiting. last light = "
msg_nl:         .string "\n"
