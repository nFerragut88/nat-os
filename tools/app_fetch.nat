// app_fetch -- a NatScript program that uses the network.
//
// The language and the network stack were built separately and had never met.
// This is the first program written in NatScript that reaches off the board.
//
// It needed NO compiler change. `net` is a device.c table entry (step 387), so
// the permissions block makes the name available and net.read / net.xfer_out /
// net.xfer_in are the generic device methods the language already emits. That
// is the argument device.h has made since the table was written: anything new
// is a device, not a syscall.

permissions {
    net
}

buf request[32]
// [step 388] 68, not 64. `puts` prints until it finds a NUL, and a chunk that
// came back FULL has no NUL in it -- so the old chunk[64] ran off the end of
// its own buffer and printed whatever lay next in the arena until a zero
// turned up. The extra bytes are never transferred into, so byte 64 stays the
// zero the arena starts with, and it terminates every full block.
buf chunk[68]

// "example.com/" -- host, then path from the first slash. Written a byte at a
// time because format() builds text and this is a literal; a string literal
// cannot be handed to a device, only printed.
request[0] = 101    // e
request[1] = 120    // x
request[2] = 97     // a
request[3] = 109    // m
request[4] = 112    // p
request[5] = 108    // l
request[6] = 101    // e
request[7] = 46     // .
request[8] = 99     // c
request[9] = 111    // o
request[10] = 109   // m
request[11] = 47    // /
request[12] = 0

println("  [fetch] asking for example.com/")

if !net.xfer_out(0, request, 12) {
    println("  [fetch] refused -- a fetch is already in flight")
    exit(1)
}

// Poll rather than block. `net` is DEV_F_SLOW so each read ends this program's
// slice, which is the point: a fetch is DNS, a TCP handshake and a round trip
// over the air, and none of that should be charged to an instruction quantum.
//
// 4 is WEB_DONE, 5 is WEB_FAILED -- webfetch.h.
// The ceiling is large because each poll is a SLOW device read, which ends
// this program's slice -- so six hundred of them is a second or two of wall
// clock, not a timeout. The first version used 600 and reported "gave up in
// state 3" on a fetch that was still perfectly healthy: the request had gone
// out and the reply had not come back yet.
let state = 0
let spins = 0
while state < 4 && spins < 40000 {
    net.read(0)
    state = net.value
    spins = spins + 1
}

if state != 4 {
    print("  [fetch] gave up in state ")
    print(state)
    print(" after ")
    print(spins)
    println(" polls")
    exit(1)
}

net.read(1)
let code = net.value
net.read(2)
let length = net.value

print("  [fetch] HTTP ")
print(code)
print(", ")
print(length)
println(" bytes")

// The bytes the KERNEL could not keep. webfetch's body buffer is 768 bytes and
// a real page is longer, so `length` above is the size of what survived, not
// the size of what the server sent. Without this channel the two are
// indistinguishable -- which is what step 388 is about.
net.read(3)
let dropped = net.value

// The body, one 64-byte block at a time. DEVICE_XFER_MAX is the ceiling on a
// single transfer -- every byte crosses a kernel bounce buffer, so it is DRAM
// that exists whether or not anything transfers.
//
// EVERY block, not the first four. The old ceiling of 4 was 256 bytes against a
// `length` that has never once been that small, and the program printed "done"
// afterwards either way -- so a run that showed a fifth of the body reported
// exactly like a run that showed all of it.
let blocks = divu(length + 63, 64)
let block = 0
let shown = 0
let n = 0
let ok = 1
while block < blocks {
    if net.xfer_in(block, chunk, 64) {
        puts(chunk)
        // What that block actually carried. The last one is short whenever
        // `length` is not a multiple of 64, and the kernel zero-fills the rest
        // rather than leave the bounce buffer's previous tenant in view.
        n = length - shown
        if n > 64 {
            n = 64
        }
        shown = shown + n
    } else {
        // A refused transfer is the one case where counting blocks would lie.
        ok = 0
    }
    block = block + 1
}
println("")

// What was shown, against what there was, against what never arrived. Three
// numbers, because any one of them alone can look like success.
print("  [fetch] shown ")
print(shown)
print(" of ")
print(length)
println(" bytes held")
if dropped > 0 {
    print("  [fetch] the kernel dropped ")
    print(dropped)
    println(" more -- its body buffer is 768 bytes and the page is longer")
}

if ok == 0 {
    println("  [fetch] done -- INCOMPLETE, a transfer was refused")
    exit(1)
}
if shown != length {
    println("  [fetch] done -- INCOMPLETE")
    exit(1)
}
if dropped > 0 {
    println("  [fetch] done -- all 768 bytes kept, but TRUNCATED by the kernel")
    exit(0)
}
println("  [fetch] done -- the whole body")
