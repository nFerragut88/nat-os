/* nat-os -- Wi-Fi credentials, template.
 *
 * Copy to `kernel/wifi_secrets.h` and fill in. That filename is in .gitignore;
 * this one is committed and must never contain a real password.
 *
 * wifi_try_connect() in kernel/wifi_osi_impl.c includes it if it exists and
 * falls back to a deliberately non-existent SSID if it does not, so the tree
 * builds and the association path is still exercised without credentials --
 * the driver reports WIFI_REASON_NO_AP_FOUND (201) and everything up to the
 * existence of the access point is proven. See UM-NATOS-048 and step 217.
 *
 * The password is never printed by anything in this project. The SSID is,
 * because it is broadcast in the clear anyway; the password is reported as a
 * LENGTH, which shows the field was populated without disclosing it.
 */

#ifndef WIFI_SECRETS_H
#define WIFI_SECRETS_H

#define WIFI_STA_SSID "your-network-name"
#define WIFI_STA_PASS "your-password"

#endif
